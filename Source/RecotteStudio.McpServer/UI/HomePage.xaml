<Page
    x:Class="RecotteStudio.McpServer.UI.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RecotteStudio.McpServer.UI">
    <Page.Resources>
        <!-- 要求を受けるたびにランプを一瞬光らせ、外側へ広がる輪を出す -->
        <Storyboard x:Name="PulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="LampFlash" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.9" />
            <DoubleAnimation Storyboard.TargetName="LampRing" Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="LampRingScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="2.6" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="LampRingScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="2.6" Duration="0:0:0.7" />
        </Storyboard>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="22" MaxWidth="720" HorizontalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock Text="ホーム" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="このウィンドウを開いている間、MCPサーバーが利用できます。最小化しても動作します。" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="接続先" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="EndpointBox" IsReadOnly="True" Text="http://127.0.0.1:8765/mcp" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="作業フォルダ" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="WorkspaceText" Text="制限なし" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="アクティビティ" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="28" Height="28" VerticalAlignment="Center">
                                <Ellipse x:Name="LampRing" Width="12" Height="12" Opacity="0"
                                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="LampRingScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="LampOff" Width="12" Height="12"
                                         Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                                <Ellipse x:Name="LampOn" Width="12" Height="12" Visibility="Collapsed"
                                         Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <Ellipse x:Name="LampFlash" Width="12" Height="12" Opacity="0"
                                         Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LampTitle" Text="停止中" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="LampDetail" Text="まだ要求はありません"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ClearButton" Grid.Column="2" Content="クリア" VerticalAlignment="Center"
                                    Click="Clear_Click" />
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="16,20" TextWrapping="Wrap"
                                   Text="MCPクライアントがツールを呼び出すと、ここに記録されます。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="ActivityList" Grid.Row="2" MaxHeight="300" Padding="0,4"
                                  SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityItem">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" VerticalAlignment="Top" Margin="0,3,0,0">
                                            <FontIcon Glyph="&#xE946;" FontSize="14" Visibility="{x:Bind InfoVisibility}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Visibility="{x:Bind SuccessVisibility}"
                                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <FontIcon Glyph="&#xE783;" FontSize="14" Visibility="{x:Bind FailureVisibility}"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind RejectedVisibility}"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Time}" VerticalAlignment="Top"
                                                   Margin="0,2,0,0" FontFamily="Consolas"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Duration}" VerticalAlignment="Top"
                                                   Margin="0,2,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
