<Window
    x:Class="RecotteStudio.McpServer.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Recotte Studio MCP">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:InfoBar x:Name="StatusBar" Margin="16,12,16,8" IsOpen="True" IsClosable="False"
                          Severity="Informational" Title="起動中" Message="MCPサーバーを開始しています。" />
        <controls:NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="LeftCompact"
                                 IsSettingsVisible="True" IsBackButtonVisible="Collapsed"
                                 SelectionChanged="NavView_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="HomeItem" Icon="Home" Content="ホーム" Tag="home" />
            </controls:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </controls:NavigationView>
    </Grid>
</Window>
