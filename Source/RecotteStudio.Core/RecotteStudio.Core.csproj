<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>RecotteStudio.Core</PackageId>
    <Version>1.8.5.0</Version>
    <Authors>RecotteStudioMCP contributors</Authors>
    <Description>Unofficial, limited-version SDK for safely reading, validating, editing, and saving Recotte Studio projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/shun126/RecotteStudioMCP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageTags>recotte;recotte-studio;ccproj;sdk</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="..\..\Documents\RecotteProjects\001EmptyProject\001EmptyProject.ccproj" Link="Templates\001EmptyProject.ccproj" LogicalName="RecotteStudio.Core.Templates.Empty.ccproj" />
    <EmbeddedResource Include="..\..\Documents\RecotteProjects\002OneText\002OneText.ccproj" Link="Templates\002OneText.ccproj" LogicalName="RecotteStudio.Core.Templates.Text.ccproj" />
    <EmbeddedResource Include="..\..\Documents\RecotteProjects\004OneImage\004OneImage.ccproj" Link="Templates\004OneImage.ccproj" LogicalName="RecotteStudio.Core.Templates.Image.ccproj" />
    <EmbeddedResource Include="..\..\Documents\RecotteProjects\005OneVideo\005OneVideo.ccproj" Link="Templates\005OneVideo.ccproj" LogicalName="RecotteStudio.Core.Templates.Video.ccproj" />
    <EmbeddedResource Include="..\..\Documents\RecotteProjects\010OneAnnotationText\010OneAnnotationText.ccproj" Link="Templates\010OneAnnotationText.ccproj" LogicalName="RecotteStudio.Core.Templates.AnnotationText.ccproj" />
  </ItemGroup>
</Project>
